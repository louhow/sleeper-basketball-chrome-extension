{
  "manifest_version": 3,
  "name": "Sleeper NBA",
  "version": "1.0.0",
  "description": "Fills Sleeper's empty NBA Team and Matchup tabs: roster, schedule, projections, lineup swaps and Lock-In, plus a log of every API call it makes.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.sleeper.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://sleeper.com/*"
      ],
      "js": [
        "src/scoring.js",
        "src/model.js",
        "src/api.js",
        "src/ui.js",
        "src/view.js",
        "src/matchup.js",
        "src/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/panel.css"
      ],
      "matches": [
        "https://sleeper.com/*"
      ]
    }
  ]
}
